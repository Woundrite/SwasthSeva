# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Public URL of this API (used to build the Google OAuth redirect URI).
API_BASE_URL=http://localhost:4000
# Public URL of the frontend (used for CORS and for links inside emails).
WEB_APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------
# docker-compose maps Postgres to host port 5433 (not 5432) to avoid clashing
# with a locally installed Postgres server. Adjust if you're not using Docker.
DATABASE_URL=postgresql://mediflow:mediflow@localhost:5433/mediflow?schema=public
REDIS_URL=redis://localhost:6379

# Run queue workers inside the API process. Handy for local dev (one process
# instead of two) and on hosting tiers that only allow a single service; set
# to false and run `npm run dev:worker` / `npm run start:worker` separately
# once a dedicated worker is deployed.
RUN_WORKER_INLINE=true

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# AES-256-GCM key for encrypting Google OAuth tokens at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-me-with-a-32-byte-base64-key

# ---------------------------------------------------------------------------
# Booking rules
# ---------------------------------------------------------------------------
SLOT_HOLD_TTL_MINUTES=10
BOOKING_HORIZON_DAYS=60
MIN_BOOKING_NOTICE_MINUTES=30
MIN_CANCELLATION_NOTICE_MINUTES=120

# ---------------------------------------------------------------------------
# Email (SendGrid over SMTP in production; any SMTP provider works)
# ---------------------------------------------------------------------------
# Defaults to the local Mailpit container so email works out of the box in
# dev — nothing sent here leaves your machine. View mail at localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=MediFlow Clinic
# Production (SendGrid over SMTP):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key

# ---------------------------------------------------------------------------
# LLM (Google Gemini)
# ---------------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey. If left blank (or
# LLM_ENABLED=false), pre-visit summaries still work — they fall back to a
# deterministic, non-AI summary built from the intake fields.
LLM_ENABLED=true
GEMINI_API_KEY=your-gemini-api-key
# Check https://ai.google.dev/gemini-api/docs/models for the current list of
# available model names — Google periodically retires older ones.
GEMINI_MODEL=gemini-3.6-flash
LLM_TIMEOUT_MS=30000
LLM_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Google Calendar (OAuth 2.0)
# ---------------------------------------------------------------------------
GOOGLE_CALENDAR_ENABLED=true
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/callback

# ---------------------------------------------------------------------------
# Seed data (development only)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@mediflow.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEFAULT_PASSWORD=Password@123
